class Solution {
    public int countPrimes(int n) {
        if (n <= 2) {
            return 0;
        }

        // false means prime, true means composite (not prime)
        boolean[] isComposite = new boolean[n];
        
        // Only need to check factors up to sqrt(n)
        for (int i = 2; i * i < n; i++) {
            if (!isComposite[i]) {
                // Mark multiples of i starting from i * i
                for (int j = i * i; j < n; j += i) {
                    isComposite[j] = true;
                }
            }
        }

        int count = 0;
        for (int i = 2; i < n; i++) {
            if (!isComposite[i]) {
                count++;
            }
        }

        return count;
    }
}
